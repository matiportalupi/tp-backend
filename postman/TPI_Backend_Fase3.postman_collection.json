  "item": [
    {
      "name": "Flujo End-to-End",
      "description": "Pasos mínimos para validar el flujo cliente → logística → transportista → entrega.",
      "item": [
        {
          "name": "[Flujo] 01 - Crear solicitud",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenedorId\": 10,\n  \"ciudadOrigenId\": 1,\n  \"ciudadDestinoId\": 3\n}"
            },
            "url": {
              "raw": "{{logistica_base}}/solicitudes",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "solicitudes"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 02 - Procesar solicitud",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaEstimadaDespacho\": \"2025-12-01\",\n  \"camionId\": {{camion_id}},\n  \"depositoId\": {{deposito_id}}\n}"
            },
            "url": {
              "raw": "{{logistica_base}}/solicitudes/{{solicitud_id}}/procesar-solicitud",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "solicitudes",
                "{{solicitud_id}}",
                "procesar-solicitud"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 03 - Asignar camión tramo 1",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/asignar-camion/{{camion_id}}",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id}}",
                "asignar-camion",
                "{{camion_id}}"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 04 - Iniciar tramo 1",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/iniciar",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id}}",
                "iniciar"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 05 - Finalizar tramo 1",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/finalizar",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id}}",
                "finalizar"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 06 - Asignar camión tramo 2",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id_2}}/asignar-camion/{{camion_id}}",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id_2}}",
                "asignar-camion",
                "{{camion_id}}"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 07 - Iniciar tramo 2",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id_2}}/iniciar",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id_2}}",
                "iniciar"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 08 - Finalizar tramo 2",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/{{tramo_id_2}}/finalizar",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "{{tramo_id_2}}",
                "finalizar"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 09 - Finalizar solicitud",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{logistica_base}}/solicitudes/{{solicitud_id}}/finalizar",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "solicitudes",
                "{{solicitud_id}}",
                "finalizar"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 10 - Solicitudes pendientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{logistica_base}}/solicitudes/pendientes",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "solicitudes",
                "pendientes"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 11 - Resumen cliente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{logistica_base}}/solicitudes/{{solicitud_id}}/resumen-cliente",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "solicitudes",
                "{{solicitud_id}}",
                "resumen-cliente"
              ]
            }
          }
        },
        {
          "name": "[Flujo] 12 - Mi asignación transportista",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{logistica_base}}/tramos-ruta/mi-asignacion",
              "host": [
                "{{logistica_base}}"
              ],
              "path": [
                "tramos-ruta",
                "mi-asignacion"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AUTENTICACIÓN - Keycloak",
      "description": "Obtener JWT token para autorizar requests",
      "item": [
        {
          "name": "🔐 Obtener token (REQUERIDO PRIMERO)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": "{{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', json.access_token);",
                  "  console.log('✅ Token actualizado: ' + json.access_token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
