    {
      "name": "🚚 LOGÍSTICA - FASE 1: Rol Transportista",
      "description": "Endpoints críticos para que transportista gestione sus tramos",
      "item": [
        {
          "name": "⭐ [FASE 1] Ver mis tramos asignados",
          "request": {
            "method": "GET",
            "url": "{{logistica_base}}/tramos-ruta/mi-asignacion",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "Obtiene lista de tramos en estado ASIGNADO o INICIADO asignados al transportista autenticado"
        },
        {
          "name": "⭐ [FASE 1] Iniciar tramo",
          "request": {
            "method": "POST",
            "url": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/iniciar",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "Registra inicio de viaje: ASIGNADO → INICIADO, establece fechaRealSalida"
        },
        {
          "name": "⭐ [FASE 1] Finalizar tramo",
          "request": {
            "method": "POST",
            "url": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/finalizar",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "Registra fin de viaje: INICIADO → FINALIZADO, calcula tiempoRealHoras"
        }
      ]
    },
    {
      "name": "💰 LOGÍSTICA - FASE 2: Cálculo de Costos y Validaciones",
      "description": "Endpoints críticos para asignar camiones y calcular costos reales",
      "item": [
        {
          "name": "⭐ [FASE 2] Asignar camión a tramo (validación peso/volumen)",
          "request": {
            "method": "POST",
            "url": "{{logistica_base}}/tramos-ruta/{{tramo_id}}/asignar-camion/{{camion_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "VALIDA capacidad: peso_contenedor ≤ capacidad_camion AND volumen ≤ capacidad_volumen. ESTIMADO → ASIGNADO"
        },
        {
          "name": "⭐ [FASE 2] Obtener solicitudes pendientes (con filtros)",
          "request": {
            "method": "GET",
            "url": "{{logistica_base}}/solicitudes/pendientes?estado=PROGRAMADA&ubicacion=Buenos%20Aires",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "Lista solicitudes no finalizadas. Filtros opcionales: estado (BORRADOR/PROGRAMADA/EN_TRANSITO), ubicacion (destino)"
        },
        {
          "name": "⭐ [FASE 2] Calcular costo real y finalizar solicitud",
          "request": {
            "method": "PUT",
            "url": "{{logistica_base}}/solicitudes/{{solicitud_id}}/finalizar",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "description": "VALIDA todos tramos FINALIZADO, calcula costo real (gestión + distancia + combustible + estadía), EN_TRANSITO → ENTREGADA"
        }
      ]
    },
