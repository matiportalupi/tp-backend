              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "// Script Síncrono para crear usuario en Keycloak antes de crear el cliente",
                      "const done = pm.globals.get('done');",
                      "",
                      "async function createUserInKeycloak() {",
                      "    try {",
                      "        // 1. Obtener token de admin para Keycloak",
                      "        console.log('Obteniendo token de admin de Keycloak...');",
                      "        const tokenResponse = await pm.sendRequest({",
                      "            url: pm.collectionVariables.get('keycloak_base') + '/realms/master/protocol/openid-connect/token',",
                      "            method: 'POST',",
                      "            header: {'Content-Type': 'application/x-www-form-urlencoded'},",
                      "            body: {",
                      "                mode: 'urlencoded',",
                      "                urlencoded: [",
                      "                    {key: 'client_id', value: 'admin-cli'},",
                      "                    {key: 'username', value: 'admin'},",
                      "                    {key: 'password', value: 'admin123'},",
                      "                    {key: 'grant_type', value: 'password'}",
                      "                ]",
                      "            }",
                      "        });",
                      "        const adminToken = tokenResponse.json().access_token;",
                      "        console.log('✅ Token de admin obtenido.');",
                      "",
                      "        // 2. Crear usuario en Keycloak",
                      "        const clientData = JSON.parse(pm.request.body.raw);",
                      "        console.log(`Intentando crear usuario: ${clientData.email}`);",
                      "        const createUserResponse = await pm.sendRequest({",
                      "            url: `${pm.collectionVariables.get('keycloak_base')}/admin/realms/${pm.collectionVariables.get('realm')}/users`,",
                      "            method: 'POST',",
                      "            header: {",
                      "                'Content-Type': 'application/json',",
                      "                'Authorization': `Bearer ${adminToken}`",
                      "            },",
                      "            body: {",
                      "                mode: 'raw',",
                      "                raw: JSON.stringify({",
                      "                    username: clientData.email,",
                      "                    email: clientData.email,",
                      "                    enabled: true,",
                      "                    credentials: [{type: 'password', value: clientData.password, temporary: false}]",
                      "                })",
                      "            }",
                      "        });",
                      "",
                      "        if (createUserResponse.code >= 300) {",
                      "            throw new Error(`Error al crear usuario en Keycloak: ${createUserResponse.status} - ${createUserResponse.text()}`);",
                      "        }",
                      "        console.log('✅ Usuario creado exitosamente en Keycloak.');",
                      "",
                      "    } catch (err) {",
                      "        console.error('❌ Falló el script de pre-request:', err);",
                      "        // Detiene la ejecución de la petición principal si hay un error",
                      "        throw err;",
                      "    } finally {",
                      "        if (typeof done === 'function') {",
                      "            done();",
                      "        }",
                      "    }",
                      "}",
                      "",
                      "createUserInKeycloak();"
                    ]
                  }
                }
              ]
            },
